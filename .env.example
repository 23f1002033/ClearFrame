# ClearFrame environment configuration
# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.

# ---------------------------------------------------------------------------
# Gemini  (choose ONE path)
# ---------------------------------------------------------------------------
# Path A — AI Studio API key (simplest; what local development uses).
#   Set GOOGLE_GENAI_USE_VERTEXAI=false and supply a key.
#   GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
GOOGLE_API_KEY=
# GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# Path B — Vertex AI (Cloud Run / production).
#   Set GOOGLE_GENAI_USE_VERTEXAI=true and a REAL project id. On this path the
#   API key is ignored and Application Default Credentials are used instead.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Models. Verify availability for your key with client.models.list().
GEMINI_PARSE_MODEL=gemini-flash-latest
GEMINI_EXTRACTION_MODEL=gemini-3.1-pro-preview
GEMINI_SYNTHESIS_MODEL=gemini-3.1-pro-preview
GEMINI_ORCHESTRATOR_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRIES=3
GEMINI_MAX_CONCURRENCY=6

# Gemini safety thresholds. Deliberately permissive: screenplays contain
# violence, profanity and adult themes as ordinary subject matter, and a
# silently dropped chunk is a missed clearance item. See README.
GEMINI_SAFETY_THRESHOLD=BLOCK_ONLY_HIGH

# ---------------------------------------------------------------------------
# Parallel  (partner integration — deep sourced web research)
# ---------------------------------------------------------------------------
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_PROCESSOR=base
PARALLEL_TIMEOUT_SECONDS=300
PARALLEL_MAX_RETRIES=4
PARALLEL_MAX_CONCURRENCY=6
PARALLEL_BACKOFF_BASE_SECONDS=1.5
PARALLEL_BACKOFF_MAX_SECONDS=60

# ---------------------------------------------------------------------------
# Secret Manager (deployed environments; env vars are the local fallback)
# ---------------------------------------------------------------------------
USE_SECRET_MANAGER=false
PARALLEL_API_KEY_SECRET=clearframe-parallel-api-key
GOOGLE_API_KEY_SECRET=clearframe-google-api-key
SECRET_VERSION=latest

# ---------------------------------------------------------------------------
# Pipeline / service
# ---------------------------------------------------------------------------
SCENES_PER_EXTRACTION_CHUNK=9
MAX_EVIDENCE_PER_ITEM=8

# Paths. Defaults are relative to the repository root and rarely need changing.
# RULES_PATH=data/copyright_rules.yaml
# AUDIT_LOG_DIR=output/audit
# EXPORT_DIR=output/reports

# Service
APP_VERSION=0.1.0
PORT=8080
LOG_LEVEL=INFO
